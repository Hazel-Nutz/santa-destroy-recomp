 #include <vector>
+#include <type_traits>
+#include <unordered_map>
 namespace {
+// ---- stack sampler: where does a guest thread spend its time? ----
+// Every ~1 ms: suspend the thread, read RIP/RSP, unwind up to 24 frames (x64 unwind info),
+// resume. Frames inside the game exe are mapped back to guest PPC function addresses via the
+// recompiler's func_mappings (nearest host function start below the RIP).
+struct HostFn { uintptr_t host; uint32_t guest; };
+std::vector<HostFn> g_host_fns;
+uintptr_t g_exe_lo = 0, g_exe_hi = 0;
+
+uint32_t GuestOf(uintptr_t rip) {
+  if (rip < g_exe_lo || rip >= g_exe_hi || g_host_fns.empty()) return 0;
+  auto it = std::upper_bound(g_host_fns.begin(), g_host_fns.end(), rip,
+                             [](uintptr_t v, const HostFn& f) { return v < f.host; });
+  if (it == g_host_fns.begin()) return 0;
+  return (it - 1)->guest;
+}
+
+std::string ModuleOf(uintptr_t rip) {
+  static std::map<uintptr_t, std::string> cache;
+  HMODULE m = nullptr;
+  if (!GetModuleHandleExW(GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS |
+                              GET_MODULE_HANDLE_EX_FLAG_UNCHANGED_REFCOUNT,
+                          reinterpret_cast<LPCWSTR>(rip), &m) || !m)
+    return "?";
+  auto base = reinterpret_cast<uintptr_t>(m);
+  auto it = cache.find(base);
+  if (it == cache.end()) {
+    wchar_t w[MAX_PATH]{};
+    GetModuleFileNameW(m, w, MAX_PATH);
+    std::wstring ws(w);
+    auto slash = ws.find_last_of(L"\\/");
+    if (slash != std::wstring::npos) ws = ws.substr(slash + 1);
+    it = cache.emplace(base, std::string(ws.begin(), ws.end())).first;
+  }
+  return fmt::format("{}+{:X}", it->second, rip - base);
+}
+
+void InitSampler(const rex::PPCImageInfo& info) {
+  if (!info.func_mappings) return;
+  for (int i = 0; info.func_mappings[i].guest != 0; ++i)
+    if (info.func_mappings[i].host)
+      g_host_fns.push_back({reinterpret_cast<uintptr_t>(info.func_mappings[i].host),
+                            static_cast<uint32_t>(info.func_mappings[i].guest)});
+  std::sort(g_host_fns.begin(), g_host_fns.end(),
+            [](const HostFn& a, const HostFn& b) { return a.host < b.host; });
+  HMODULE m = nullptr;
+  if (!g_host_fns.empty() &&
+      GetModuleHandleExW(GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS |
+                             GET_MODULE_HANDLE_EX_FLAG_UNCHANGED_REFCOUNT,
+                         reinterpret_cast<LPCWSTR>(g_host_fns[0].host), &m)) {
+    auto* dos = reinterpret_cast<IMAGE_DOS_HEADER*>(m);
+    auto* nt = reinterpret_cast<IMAGE_NT_HEADERS*>(reinterpret_cast<uint8_t*>(m) + dos->e_lfanew);
+    g_exe_lo = reinterpret_cast<uintptr_t>(m);
+    g_exe_hi = g_exe_lo + nt->OptionalHeader.SizeOfImage;
+  }
+}
+
+void StartSampler() {
+  std::string want = REXCVAR_GET(perf_sample_thread);
+  int interval = REXCVAR_GET(perf_report_seconds);
+  if (want.empty() || g_host_fns.empty()) return;
+  if (interval <= 0) interval = 10;
+  std::thread([want, interval]() {
+    using GetDescFn = HRESULT(WINAPI*)(HANDLE, PWSTR*);
+    auto get_desc = reinterpret_cast<GetDescFn>(
+        GetProcAddress(GetModuleHandleW(L"kernel32.dll"), "GetThreadDescription"));
+    HANDLE timer = CreateWaitableTimerExW(nullptr, nullptr, 0x2 /*HIGH_RESOLUTION*/, TIMER_ALL_ACCESS);
+    if (!timer) timer = CreateWaitableTimerExW(nullptr, nullptr, 0, TIMER_ALL_ACCESS);
+    const DWORD pid = GetCurrentProcessId();
+    constexpr int kFrames = 24;
+    for (;;) {
+      // Find target threads (re-scanned every report).
+      std::vector<HANDLE> targets;
+      HANDLE snap = CreateToolhelp32Snapshot(TH32CS_SNAPTHREAD, 0);
+      if (snap != INVALID_HANDLE_VALUE) {
+        THREADENTRY32 te{sizeof(te)};
+        for (BOOL ok = Thread32First(snap, &te); ok; ok = Thread32Next(snap, &te)) {
+          if (te.th32OwnerProcessID != pid || te.th32ThreadID == GetCurrentThreadId()) continue;
+          HANDLE h = OpenThread(THREAD_SUSPEND_RESUME | THREAD_GET_CONTEXT |
+                                    THREAD_QUERY_LIMITED_INFORMATION, FALSE, te.th32ThreadID);
+          if (!h) continue;
+          PWSTR w = nullptr;
+          bool match = false;
+          if (get_desc && SUCCEEDED(get_desc(h, &w)) && w) {
+            std::wstring ws(w);
+            std::string n(ws.begin(), ws.end());
+            match = n.rfind(want, 0) == 0;
+            LocalFree(w);
+          }
+          if (match) targets.push_back(h); else CloseHandle(h);
+        }
+        CloseHandle(snap);
+      }
+      if (targets.empty()) { Sleep(interval * 1000); continue; }
+
+      std::unordered_map<uint32_t, uint32_t> self_hits;   // innermost guest function
+      std::unordered_map<uint64_t, uint32_t> pair_hits;   // innermost guest fn <- its guest caller
+      std::unordered_map<uint32_t, uint32_t> incl_hits;   // any guest frame on the stack
+      std::map<std::string, uint32_t> leaf_hits;          // leaf module+offset when not in game code
+      uint32_t samples = 0, in_game_leaf = 0;
+      const auto end = GetTickCount64() + uint64_t(interval) * 1000;
+      while (GetTickCount64() < end) {
+        LARGE_INTEGER due; due.QuadPart = -10000;  // 1 ms
+        if (timer) { SetWaitableTimer(timer, &due, 0, nullptr, nullptr, FALSE); WaitForSingleObject(timer, 5); }
+        else Sleep(1);
+        for (HANDLE h : targets) {
+          uintptr_t frames[kFrames]; int n = 0;
+          if (SuspendThread(h) == (DWORD)-1) continue;
+          CONTEXT c{}; c.ContextFlags = CONTEXT_FULL;
+          if (GetThreadContext(h, &c)) {
+            for (; n < kFrames && c.Rip; ++n) {
+              frames[n] = c.Rip;
+              DWORD64 img = 0;
+              auto* fe = RtlLookupFunctionEntry(c.Rip, &img, nullptr);
+              if (!fe) {  // leaf without unwind info: return address is at [rsp]
+                if (n > 0 || !c.Rsp) { ++n; break; }  // unknown frame further up: stop
+                c.Rip = *reinterpret_cast<DWORD64*>(c.Rsp); c.Rsp += 8;
+              } else {
+                void* hd = nullptr; DWORD64 est = 0;
+                RtlVirtualUnwind(UNW_FLAG_NHANDLER, img, c.Rip, fe, &c, &hd, &est, nullptr);
+              }
+            }
+          }
+          ResumeThread(h);
+          if (!n) continue;
+          ++samples;
+          uint32_t g[3] = {}; int gi = 0;
+          std::vector<uint32_t> seen;
+          for (int i = 0; i < n; ++i) {
+            uint32_t ga = GuestOf(frames[i]);
+            if (!ga) continue;
+            if (gi < 3 && (gi == 0 || g[gi - 1] != ga)) g[gi++] = ga;
+            if (std::find(seen.begin(), seen.end(), ga) == seen.end()) { seen.push_back(ga); ++incl_hits[ga]; }
+          }
+          if (GuestOf(frames[0])) ++in_game_leaf; else ++leaf_hits[ModuleOf(frames[0])];
+          if (g[0]) { ++self_hits[g[0]]; ++pair_hits[(uint64_t(g[0]) << 32) | g[1]]; }
+        }
+      }
+      for (HANDLE h : targets) CloseHandle(h);
+      if (!samples) continue;
+      auto top = [&](auto& m, size_t k) {
+        std::vector<std::pair<typename std::decay_t<decltype(m)>::key_type, uint32_t>> v(m.begin(), m.end());
+        std::sort(v.begin(), v.end(), [](auto& a, auto& b) { return a.second > b.second; });
+        if (v.size() > k) v.resize(k);
+        return v;
+      };
+      auto pc = [&](uint32_t x) { return x * 100.0 / samples; };
+      std::string l = fmt::format("[sample] '{}' {} samples, leaf in game code {:.0f}% | self:", want,
+                                  samples, pc(in_game_leaf));
+      for (auto& [a, k] : top(self_hits, 20)) l += fmt::format(" {:08X} {:.1f}%", a, pc(k));
+      REXSYS_INFO("{}", l);
+      l = "[sample] caller pairs:";
+      for (auto& [a, k] : top(pair_hits, 20))
+        l += fmt::format(" {:08X}<-{:08X} {:.1f}%", uint32_t(a >> 32), uint32_t(a), pc(k));
+      REXSYS_INFO("{}", l);
+      l = "[sample] inclusive:";
+      for (auto& [a, k] : top(incl_hits, 25)) l += fmt::format(" {:08X} {:.0f}%", a, pc(k));
+      REXSYS_INFO("{}", l);
+      l = "[sample] host leaf:";
+      for (auto& [a, k] : top(leaf_hits, 15)) l += fmt::format(" {} {:.1f}%", a, pc(k));
+      REXSYS_INFO("{}", l);
+    }
+  }).detach();
+}
