 std::atomic<uint64_t> g_work_calls{0}, g_progress_calls{0}, g_no_space_calls{0};
+
+// Per-voice tracking (xma_diag): one line per decoded voice when it ends -- format, how much audio
+// it produced and its peak level -- plus a 10 s summary split by mono/stereo and looping.
+// Purpose: find which class of voice (e.g. first-person weapon sounds) comes out silent or short.
+struct VoiceTrack {
+  bool active = false;
+  uint32_t stereo = 0, rate = 0, loop_n = 0, loop_s = 0, loop_e = 0, sdc = 0, out_blocks = 0;
+  uint32_t in0_pk = 0, in1_pk = 0, in_ptr = 0;
+  uint64_t blocks = 0, kicks = 0, zero_kicks = 0, swaps = 0;
+  int peak = 0;
+  uint32_t err = 0, parse_err = 0;
+  std::chrono::steady_clock::time_point t0;
+};
+std::array<VoiceTrack, 512> g_voices{};
+std::atomic<uint32_t> g_voice_lines{0};
+struct VoiceSum { uint64_t voices = 0, silent = 0, blocks = 0, errs = 0; };
+std::array<VoiceSum, 4> g_vsum{};  // [stereo*2 + looping]
+std::mutex g_vsum_mutex;
+
+void VoiceFinish(uint32_t id, const char* why) {
+  if (id >= g_voices.size()) return;
+  auto& v = g_voices[id];
+  if (!v.active) return;
+  v.active = false;
+  const bool silent = v.peak < 64;  // < -54 dBFS
+  {
+    std::lock_guard<std::mutex> l(g_vsum_mutex);
+    auto& sm = g_vsum[v.stereo * 2 + (v.loop_n ? 1 : 0)];
+    sm.voices++; sm.blocks += v.blocks; sm.silent += silent; sm.errs += (v.err || v.parse_err);
+  }
+  if (g_voice_lines.fetch_add(1) < 600) {
+    const auto ms = std::chrono::duration_cast<std::chrono::milliseconds>(
+                        std::chrono::steady_clock::now() - v.t0).count();
+    REXAPU_INFO(
+        "[xma-voice] ctx {} end({}) {} {}Hz loop n{} s{} e{} | in {:08X} pk{}/{} sdc{} outblk{} | "
+        "kicks {} empty-kicks {} swaps {} | out {} blk ({:.0f} ms audio) peak {} | err {}/{} | {} ms",
+        id, why, v.stereo ? "STEREO" : "mono", v.rate, v.loop_n, v.loop_s, v.loop_e, v.in_ptr,
+        v.in0_pk, v.in1_pk, v.sdc, v.out_blocks, v.kicks, v.zero_kicks, v.swaps, v.blocks,
+        v.blocks * 128.0 / (v.stereo ? 2 : 1) * 1000.0 / (v.rate ? v.rate : 48000), v.peak, v.err,
+        v.parse_err, ms);
+  }
+}
+
+void VoiceTrackWork(uint32_t id, const rex::audio::XMA_CONTEXT_DATA& init, const rex::audio::XMA_CONTEXT_DATA& d,
+                    const uint8_t* out_base) {
+  if (id >= g_voices.size()) return;
+  auto& v = g_voices[id];
+  const bool fresh = init.output_buffer_write_offset == 0 && init.output_buffer_read_offset == 0 &&
+                     init.current_buffer == 0 && init.input_buffer_read_offset == 32 &&
+                     init.input_buffer_0_valid;
+  if (fresh || !v.active) {
+    if (v.active) VoiceFinish(id, "restart");
+    v = VoiceTrack{};
+    v.active = true;
+    v.stereo = init.is_stereo; v.rate = init.sample_rate; v.loop_n = init.loop_count;
+    v.loop_s = init.loop_start; v.loop_e = init.loop_end; v.sdc = init.subframe_decode_count;
+    v.out_blocks = init.output_buffer_block_count; v.in0_pk = init.input_buffer_0_packet_count;
+    v.in1_pk = init.input_buffer_1_packet_count; v.in_ptr = init.input_buffer_0_ptr;
+    v.t0 = std::chrono::steady_clock::now();
+  }
+  v.kicks++;
+  if (d.current_buffer != init.current_buffer) v.swaps++;
+  const uint32_t cap = init.output_buffer_block_count;
+  uint32_t w0 = init.output_buffer_write_offset, w1 = d.output_buffer_write_offset;
+  if (!cap || w0 >= cap || w1 >= cap) return;
+  uint32_t n = (w1 + cap - w0) % cap;
+  if (!n) { v.zero_kicks++; }
+  v.blocks += n;
+  for (uint32_t b = 0; b < n; ++b) {
+    const uint8_t* p = out_base + ((w0 + b) % cap) * 256;
+    for (int i = 0; i < 256; i += 2) {
+      int s16 = int16_t((p[i] << 8) | p[i + 1]);
+      if (s16 < 0) s16 = -s16;
+      if (s16 > v.peak) v.peak = s16;
+    }
+  }
+  if (d.error_status) v.err = d.error_status;
+  if (d.parser_error_status) v.parse_err = d.parser_error_status;
+}
 }  // namespace
 
