@@ -33,6 +33,81 @@ REXCVAR_DEFINE_STRING(user_data_root, "", "Runtime", "Override user data path");
 REXCVAR_DEFINE_STRING(update_data_root, "", "Runtime", "Override update data path");
 REXCVAR_DEFINE_STRING(cache_root, "", "Runtime", "Override shader cache path");
 REXCVAR_DEFINE_STRING(metadata_root, "", "Runtime", "Override metadata path");
+REXCVAR_DEFINE_INT32(perf_report_seconds, 0, "Runtime",
+                     "BO3 diagnostics: every N seconds log per-thread CPU usage (0 = off, Windows)");
+
+#if REX_PLATFORM_WIN32
+#include <windows.h>
+#include <tlhelp32.h>
+#include <algorithm>
+#include <map>
+#include <thread>
+#include <vector>
+namespace {
+// Logs the busiest threads of this process: % of one core over the last interval, by thread
+// name (SDK/guest threads are named via SetThreadDescription). Read-only, ~0.1 ms per report.
+void StartPerfReporter() {
+  const int interval = REXCVAR_GET(perf_report_seconds);
+  if (interval <= 0) return;
+  std::thread([interval]() {
+    using GetDescFn = HRESULT(WINAPI*)(HANDLE, PWSTR*);
+    auto get_desc = reinterpret_cast<GetDescFn>(
+        GetProcAddress(GetModuleHandleW(L"kernel32.dll"), "GetThreadDescription"));
+    std::map<DWORD, uint64_t> last;
+    uint64_t last_proc = 0;
+    auto ft = [](const FILETIME& f) { return (uint64_t(f.dwHighDateTime) << 32) | f.dwLowDateTime; };
+    const DWORD pid = GetCurrentProcessId();
+    for (;;) {
+      std::this_thread::sleep_for(std::chrono::seconds(interval));
+      struct Row { double pct; std::string name; DWORD tid; };
+      std::vector<Row> rows;
+      HANDLE snap = CreateToolhelp32Snapshot(TH32CS_SNAPTHREAD, 0);
+      if (snap == INVALID_HANDLE_VALUE) continue;
+      THREADENTRY32 te{sizeof(te)};
+      std::map<DWORD, uint64_t> now;
+      for (BOOL ok = Thread32First(snap, &te); ok; ok = Thread32Next(snap, &te)) {
+        if (te.th32OwnerProcessID != pid) continue;
+        HANDLE h = OpenThread(THREAD_QUERY_LIMITED_INFORMATION, FALSE, te.th32ThreadID);
+        if (!h) continue;
+        FILETIME c, e, k, u;
+        if (GetThreadTimes(h, &c, &e, &k, &u)) {
+          uint64_t t = ft(k) + ft(u);
+          now[te.th32ThreadID] = t;
+          auto it = last.find(te.th32ThreadID);
+          uint64_t d = it == last.end() ? 0 : t - it->second;
+          double pct = d / (interval * 1e7) * 100.0;
+          if (pct >= 1.0) {
+            std::string name = "?";
+            PWSTR w = nullptr;
+            if (get_desc && SUCCEEDED(get_desc(h, &w)) && w) {
+              int n = WideCharToMultiByte(CP_UTF8, 0, w, -1, nullptr, 0, nullptr, nullptr);
+              if (n > 1) { name.assign(n - 1, 0); WideCharToMultiByte(CP_UTF8, 0, w, -1, name.data(), n, nullptr, nullptr); }
+              LocalFree(w);
+            }
+            rows.push_back({pct, name, te.th32ThreadID});
+          }
+        }
+        CloseHandle(h);
+      }
+      CloseHandle(snap);
+      last.swap(now);
+      FILETIME c, e, k, u;
+      GetProcessTimes(GetCurrentProcess(), &c, &e, &k, &u);
+      uint64_t proc = ft(k) + ft(u);
+      double total = last_proc ? (proc - last_proc) / (interval * 1e7) * 100.0 : 0;
+      last_proc = proc;
+      std::sort(rows.begin(), rows.end(), [](auto& a, auto& b) { return a.pct > b.pct; });
+      std::string line = fmt::format("[perf] process {:.0f}% of one core |", total);
+      for (size_t i = 0; i < rows.size() && i < 14; ++i)
+        line += fmt::format(" {}({}) {:.0f}%", rows[i].name, rows[i].tid, rows[i].pct);
+      REXSYS_INFO("{}", line);
+    }
+  }).detach();
+}
+}  // namespace
+#else
+namespace { void StartPerfReporter() {} }
+#endif
 
 namespace rex {
 
