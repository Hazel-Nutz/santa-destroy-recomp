 #include <rex/system/xtypes.h>
 #include <rex/ui/flags.h>
 
+#include <chrono>
+#include <thread>
+#if REX_PLATFORM_WIN32
+#include <windows.h>
+#endif
+
+REXCVAR_DEFINE_INT32(frame_rate_limit, 0, "GPU",
+                     "BO3: cap the game's frame rate (frames presented per second). 0 = off");
+
+namespace {
+// Frame limiter applied in VdSwap (the guest's present). Waiting here paces the whole render
+// loop, which also frees CPU for other threads. Uses a high-resolution waitable timer so the
+// wait is precise without spinning; falls back to sleep + a short spin.
+void LimitFrameRate() {
+  const int fps = REXCVAR_GET(frame_rate_limit);
+  if (fps <= 0) return;
+  using clock = std::chrono::steady_clock;
+  static clock::time_point next{};
+  const auto interval = std::chrono::nanoseconds(1000000000LL / fps);
+  auto now = clock::now();
+  if (next.time_since_epoch().count() == 0 || now > next + interval * 2) {
+    next = now + interval;  // first frame, or far behind (hitch/load): resync, no catch-up burst
+    return;
+  }
+  if (now < next) {
+#if REX_PLATFORM_WIN32
+    static HANDLE timer = CreateWaitableTimerExW(nullptr, nullptr, 0x00000002 /*HIGH_RESOLUTION*/,
+                                                 TIMER_ALL_ACCESS);
+    auto remaining = next - now;
+    if (timer) {
+      LARGE_INTEGER due;
+      due.QuadPart = -static_cast<LONGLONG>(
+          std::chrono::duration_cast<std::chrono::nanoseconds>(remaining).count() / 100);
+      if (SetWaitableTimer(timer, &due, 0, nullptr, nullptr, FALSE)) {
+        WaitForSingleObject(timer, INFINITE);
+      }
+    } else if (remaining > std::chrono::milliseconds(2)) {
+      std::this_thread::sleep_for(remaining - std::chrono::milliseconds(2));
+    }
+#else
+    std::this_thread::sleep_until(next);
+#endif
+    while (clock::now() < next) std::this_thread::yield();
+  }
+  next += interval;
+}
+}  // namespace
+
