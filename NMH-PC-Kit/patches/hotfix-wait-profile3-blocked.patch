+// Waits still in progress (a thread blocked for minutes never reaches Record()).
+struct InFlight {
+  char kind;
+  uint32_t extra;
+  std::chrono::steady_clock::time_point start;
+  std::array<uint32_t, 6> stack;
+};
+static std::map<std::string, InFlight> inflight;
+
+// Guest call stack: LR register, then saved LRs via the PPC back chain (callee saves LR at
+// backchain-8 in the 360 ABI: "mflr r12; stw r12,-8(r1); stwu r1,-N(r1)").
+static std::array<uint32_t, 6> GuestStack(XThread* th) {
+  std::array<uint32_t, 6> out{};
+  if (!th || !th->thread_state()) return out;
+  auto* ctx = th->thread_state()->context();
+  out[0] = uint32_t(ctx->lr);
+  uint32_t frame = uint32_t(ctx->r1.u32);
+  auto* mem = REX_KERNEL_MEMORY();
+  for (size_t i = 1; i < out.size() && frame >= 0x40000000u && frame < 0xF0000000u; ++i) {
+    uint32_t back = rex::memory::load_and_swap<uint32_t>(mem->TranslateVirtual(frame));
+    if (back <= frame || back - frame > 0x100000) break;
+    out[i] = rex::memory::load_and_swap<uint32_t>(mem->TranslateVirtual(back - 8));
+    frame = back;
+  }
+  return out;
+}
+
+static std::string ThreadKey(XThread* th) {
+  if (!th) return "host";
+  return fmt::format("{}#{:X}", th->name(), th->thread_id());
+}
+
+void Begin(char kind, uint32_t extra) {
+  if (!REXCVAR_GET(wait_profile)) return;
+  auto* th = XThread::GetCurrentThread();
+  InFlight f{kind, extra, std::chrono::steady_clock::now(), GuestStack(th)};
+  std::lock_guard<std::mutex> lock(mu);
+  inflight[ThreadKey(th)] = f;
+}
+
+void End() {
+  if (!REXCVAR_GET(wait_profile)) return;
+  auto* th = XThread::GetCurrentThread();
+  std::lock_guard<std::mutex> lock(mu);
+  inflight.erase(ThreadKey(th));
+}
