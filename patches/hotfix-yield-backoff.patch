@@ -390,6 +395,11 @@ u32 KeDelayExecutionThread_entry(u32 processor_mode, u32 alertable, mapped_u64 i
 }
 
 u32 NtYieldExecution_entry() {
+  const int backoff = REXCVAR_GET(yield_backoff_spins);
+  if (backoff > 0) {
+    rex::thread::MaybeYieldBackoff(backoff, REXCVAR_GET(yield_backoff_us));
+    return X_STATUS_SUCCESS;
+  }
   rex::thread::MaybeYield();
   return X_STATUS_SUCCESS;
 }
