@@ -754,11 +759,26 @@ bool XmaContext::DecodePacket(AVCodecContext* av_context, const AVPacket* av_pac
 void XmaContext::Decode(XMA_CONTEXT_DATA* data) {
   SCOPE_profile_cpu_f("apu");
 
-  if (!data->IsAnyInputBufferValid()) {
+  if (current_frame_remaining_subframes_ > 0) {
     return;
   }
 
-  if (current_frame_remaining_subframes_ > 0) {
+  if (!data->IsAnyInputBufferValid()) {
+    // Output realignment holds the second part of every decoded frame back until the next frame
