diff --git a/src/audio/audio_system.cpp b/src/audio/audio_system.cpp
index 7a711a8..03d9a38 100644
--- a/src/audio/audio_system.cpp
+++ b/src/audio/audio_system.cpp
@@ -92,6 +92,17 @@ X_STATUS AudioSystem::Setup(system::KernelState* kernel_state) {
 
   worker_thread_->set_name("Audio Worker");
   worker_thread_->Create();
+  // BO3: these host threads run the guest audio callback / XMA decode. At normal priority they
+  // lose CPU to busy game threads on 4-core PCs, the output queue drains and SDL plays silence
+  // (audible dropouts). Run them above everything the game creates: Windows TIME_CRITICAL (15),
+  // the level SDL uses for its own audio thread; the game's threads top out at HIGHEST (2).
+  if (worker_thread_->thread()) {
+#if REX_PLATFORM_WIN32
+    worker_thread_->thread()->set_priority(15);
+#else
+    worker_thread_->thread()->set_priority(rex::thread::ThreadPriority::kHighest);
+#endif
+  }
 
   return X_STATUS_SUCCESS;
 }
