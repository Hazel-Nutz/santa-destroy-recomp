   period_ms = chrono::Clock::ScaleGuestDurationMillis(period_ms);
   WinSystemClock::time_point due_tp;
@@ -85,7 +86,8 @@
         timer_->SetRepeatingAt(due_tp, std::chrono::milliseconds(period_ms), std::move(callback));
   }
 
