+
 namespace {
 // Per-context no-progress streaks; logged once per streak so the log stays small.
 std::array<uint32_t, 512> g_no_progress{};
@@ -335,7 +339,8 @@ bool XmaContext::Work() {
     // and a game polling for the remainder never kicks again -> it spins forever (BO3's
