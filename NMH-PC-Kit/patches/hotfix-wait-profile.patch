 namespace rex::kernel::xboxkrnl {
 using namespace rex::system;
+
+// ---------------------------------------------------------------------------------------------
+// Wait profiler (cvar wait_profile): per guest thread, how long it spends in kernel waits, delays
+// and file reads, keyed by the guest return address. Reported every perf_report_seconds (5 s if 0).
+// Used to find what a loading screen is waiting on.
+REXCVAR_DEFINE_BOOL(wait_profile, false, "Kernel",
+                    "Log per-thread wait/delay/read time by guest caller every perf_report_seconds");
+
+REXCVAR_DECLARE(int32_t, perf_report_seconds);
+
+namespace waitprof {
+struct Stat {
+  uint64_t n = 0, us = 0, timeouts = 0, bytes = 0;
+};
+static std::mutex mu;
+static std::map<std::tuple<std::string, char, uint32_t, uint32_t>, Stat> stats;
+static std::chrono::steady_clock::time_point last_report = std::chrono::steady_clock::now();
+
+static void Report() {
+  // mu held
+  std::map<std::string, std::array<uint64_t, 4>> per_thread;  // wait, delay, read us, read bytes
+  std::vector<std::pair<uint64_t, std::string>> lines;
+  static const char* kTypes[] = {"?", "Enum", "Event", "File", "IOCompl", "Module", "Mutant",
+                                 "Notify", "Sema", "Session", "Socket", "SymLink", "Thread", "Timer"};
+  for (auto& [k, v] : stats) {
+    auto& [thread, kind, lr, extra] = k;
+    auto& t = per_thread[thread];
+    if (kind == 'D') t[1] += v.us;
+    else if (kind == 'R') { t[2] += v.us; t[3] += v.bytes; }
+    else t[0] += v.us;
+    std::string what = kind == 'D'   ? fmt::format("delay {}ms", extra)
+                       : kind == 'R' ? fmt::format("read {}KB", v.bytes / 1024)
+                       : kind == 'M' ? fmt::format("waitmulti x{}", extra)
+                                     : fmt::format("wait {}", extra < 14 ? kTypes[extra] : "?");
+    lines.push_back({v.us, fmt::format("{} {} @{:08X}: {}x {:.0f}ms{}", thread, what, lr, v.n,
+                                       v.us / 1000.0,
+                                       v.timeouts ? fmt::format(" ({} timeouts)", v.timeouts) : "")});
+  }
+  for (auto& [thread, t] : per_thread) {
+    REXKRNL_INFO("[wait] {}: waits {:.0f}ms, delays {:.0f}ms, reads {:.0f}ms ({} KB)", thread,
+                 t[0] / 1000.0, t[1] / 1000.0, t[2] / 1000.0, t[3] / 1024);
+  }
+  std::sort(lines.rbegin(), lines.rend());
+  for (size_t i = 0; i < lines.size() && i < 20; ++i) REXKRNL_INFO("[wait]   {}", lines[i].second);
+  stats.clear();
+}
+
+void Record(char kind, uint32_t extra, uint64_t us, bool timed_out, uint64_t bytes) {
+  if (!REXCVAR_GET(wait_profile)) return;
+  auto* th = XThread::GetCurrentThread();
+  std::string name = th ? th->name() : std::string("host");
+  uint32_t lr = th && th->thread_state() ? uint32_t(th->thread_state()->context()->lr) : 0;
+  std::lock_guard<std::mutex> lock(mu);
+  auto& st = stats[{name, kind, lr, extra}];
+  st.n++;
+  st.us += us;
+  st.bytes += bytes;
+  if (timed_out) st.timeouts++;
+  auto now = std::chrono::steady_clock::now();
+  int secs = REXCVAR_GET(perf_report_seconds);
+  if (now - last_report >= std::chrono::seconds(secs > 0 ? secs : 5)) {
+    last_report = now;
+    Report();
+  }
+}
+
+struct Timer {
+  std::chrono::steady_clock::time_point t0 = std::chrono::steady_clock::now();
+  uint64_t us() const {
+    return uint64_t(std::chrono::duration_cast<std::chrono::microseconds>(
+                        std::chrono::steady_clock::now() - t0)
+                        .count());
+  }
+};
+}  // namespace waitprof
