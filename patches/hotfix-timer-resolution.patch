+// Windows rounds every Sleep/SleepEx/timed wait up to the system timer tick (15.625 ms unless a
+// process asks for finer). Games stream data in loops of short sleeps/waits (Sleep(1), 1-2 ms
+// event timeouts), which then take ~15 ms each: loading screens become many times slower.
+// Requested lazily on the first guest sleep, i.e. after the .toml config has been loaded.
+static void EnsureTimerResolution() {
+  static std::once_flag once;
+  std::call_once(once, [] {
+    int32_t us = REXCVAR_GET(timer_resolution_us);
+    if (us <= 0) {
+      spdlog::info("Timer resolution: Windows default (timer_resolution_us = 0)");
+      return;
+    }
+    // Windows 11 may ignore a process's timer request while it is throttled/occluded unless it
+    // opts out of PROCESS_POWER_THROTTLING_IGNORE_TIMER_RESOLUTION.
+    struct PowerThrottling { ULONG Version, ControlMask, StateMask; };
+    PowerThrottling pt{1, 0x4 /*IGNORE_TIMER_RESOLUTION*/, 0};
+    SetProcessInformation(GetCurrentProcess(), static_cast<PROCESS_INFORMATION_CLASS>(4) /*ProcessPowerThrottling*/,
+                          &pt, sizeof(pt));
+    using NtSetTimerResolutionFn = LONG(NTAPI*)(ULONG, BOOLEAN, PULONG);
+    auto fn = reinterpret_cast<NtSetTimerResolutionFn>(
+        GetProcAddress(GetModuleHandleW(L"ntdll.dll"), "NtSetTimerResolution"));
+    ULONG actual = 0;
+    LONG st = fn ? fn(ULONG(us) * 10, TRUE, &actual) : -1;
+    spdlog::info("Timer resolution: requested {} us, now {:.3f} ms (status 0x{:08X})", us,
+                 actual / 10000.0, uint32_t(st));
+  });
+}
