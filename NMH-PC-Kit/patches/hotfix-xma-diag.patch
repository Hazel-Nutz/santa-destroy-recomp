   size_t index = context_bitmap_.Acquire();
   if (index == -1) {
     // Out of contexts.
+    static uint32_t warned = 0;
+    if (warned++ < 20) REXAPU_WARN("[xma-diag] XMACreateContext: out of contexts ({} in use)", kContextCount);
     return 0;
   }
 
