diff --git a/src/core/threading_win.cpp b/src/core/threading_win.cpp
index 896dfec..7fd2148 100644
--- a/src/core/threading_win.cpp
+++ b/src/core/threading_win.cpp
@@ -89,6 +89,40 @@ void MaybeYield() {
   MemoryBarrier();
 }
 
+// BO3: guest spin-wait loops call NtYieldExecution in a tight loop. On a 4-core PC SwitchToThread
+// usually returns at once (nothing else ready on this core), so the loop burns a whole core while
+// the thread it waits for may be starved. After `threshold` back-to-back yields (gaps < 200 us) the
+// thread sleeps `sleep_us` on a high-resolution timer instead, then the count restarts.
+void MaybeYieldBackoff(int threshold, int sleep_us) {
+  thread_local int streak = 0;
+  thread_local LARGE_INTEGER last{};
+  thread_local HANDLE timer = nullptr;
+  static LARGE_INTEGER freq = [] { LARGE_INTEGER f; QueryPerformanceFrequency(&f); return f; }();
+  LARGE_INTEGER now;
+  QueryPerformanceCounter(&now);
+  if (last.QuadPart && (now.QuadPart - last.QuadPart) * 1000000 / freq.QuadPart < 200) {
+    ++streak;
+  } else {
+    streak = 0;
+  }
+  last = now;
+  if (threshold > 0 && streak >= threshold) {
+    streak = 0;
+    if (!timer) timer = CreateWaitableTimerExW(nullptr, nullptr, 0x2 /*HIGH_RESOLUTION*/, TIMER_ALL_ACCESS);
+    if (timer) {
+      LARGE_INTEGER due;
+      due.QuadPart = -10LL * sleep_us;
+      SetWaitableTimer(timer, &due, 0, nullptr, nullptr, FALSE);
+      WaitForSingleObject(timer, 5);
+      QueryPerformanceCounter(&last);
+      MemoryBarrier();
+      return;
+    }
+  }
+  SwitchToThread();
+  MemoryBarrier();
+}
+
 void SyncMemory() {
   MemoryBarrier();
 }
