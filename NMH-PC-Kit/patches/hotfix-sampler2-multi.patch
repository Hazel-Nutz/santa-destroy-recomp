+// perf_sample_thread may list several thread-name prefixes separated by commas
+// ("Main,GPU Commands,JQ Worker"); each gets its own sampler and its own [sample] lines.
+void StartSampler() {
+  std::string list = REXCVAR_GET(perf_sample_thread);
+  int interval = REXCVAR_GET(perf_report_seconds);
+  if (list.empty() || g_host_fns.empty()) return;
+  if (interval <= 0) interval = 10;
+  size_t pos = 0;
+  while (pos <= list.size()) {
+    size_t comma = list.find(',', pos);
+    std::string item = list.substr(pos, comma == std::string::npos ? std::string::npos : comma - pos);
+    while (!item.empty() && item.front() == ' ') item.erase(item.begin());
+    while (!item.empty() && item.back() == ' ') item.pop_back();
+    if (!item.empty()) StartSamplerFor(item, interval);
+    if (comma == std::string::npos) break;
+    pos = comma + 1;
+  }
+}
