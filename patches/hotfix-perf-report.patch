       flags.skip_lr, flags.skip_msr, flags.ctr_as_local, flags.xer_as_local, flags.cr_as_local,
       flags.reserved_as_local, flags.non_argument_as_local, flags.non_volatile_as_local);
 
+  StartPerfReporter();
   return X_STATUS_SUCCESS;
 }
 
