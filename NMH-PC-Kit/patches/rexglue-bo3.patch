+static uint64_t StickBits(bool u, bool d, bool l, bool r) {
+  if (u && d) u = d = false;
+  if (l && r) l = r = false;
+  if (u && l) return 1u << 4;
+  if (u && r) return 1u << 5;
+  if (d && r) return 1u << 6;
+  if (d && l) return 1u << 7;
+  if (u) return 1u << 0;
+  if (d) return 1u << 1;
+  if (r) return 1u << 2;
+  if (l) return 1u << 3;
+  return 0;
