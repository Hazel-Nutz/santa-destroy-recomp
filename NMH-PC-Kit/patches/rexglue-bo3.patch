+
+static void PollInjectFile(bool (&a)[256], bool (&b)[256]) {
+  const char* path = InjectPath();
+  if (!path) return;
+  FILE* f = std::fopen(path, "rb");
+  if (!f) return;
+  char buf[512] = {};
+  size_t n = std::fread(buf, 1, sizeof(buf) - 1, f);
+  std::fclose(f);
+  std::remove(path);
+  std::string_view sv(buf, n);
+  size_t i = 0;
+  while (i < sv.size()) {
+    while (i < sv.size() && (sv[i] == ' ' || sv[i] == '\n' || sv[i] == '\r' || sv[i] == ',')) ++i;
+    size_t j = i;
+    while (j < sv.size() && !(sv[j] == ' ' || sv[j] == '\n' || sv[j] == '\r' || sv[j] == ',')) ++j;
+    if (j > i) {
+      auto vk = static_cast<uint16_t>(rex::ui::ParseVirtualKey(sv.substr(i, j - i)));
+      if (vk && vk < 256) a[vk] = b[vk] = true;
+      REXLOG_INFO("[mnk] inject {} -> vk {:02X}", sv.substr(i, j - i), vk);
+    }
+    i = j;
+  }
+}
