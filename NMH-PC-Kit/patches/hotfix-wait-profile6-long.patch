diff --git a/src/kernel/xboxkrnl/xboxkrnl_threading.cpp b/src/kernel/xboxkrnl/xboxkrnl_threading.cpp
--- a/src/kernel/xboxkrnl/xboxkrnl_threading.cpp	2026-10-17 23:14:05.893290334 +0700
+++ b/src/kernel/xboxkrnl/xboxkrnl_threading.cpp	2026-10-17 23:14:05.898631530 +0700
@@ -121,7 +121,33 @@
   if (!REXCVAR_GET(wait_profile)) return;
   auto* th = XThread::GetCurrentThread();
   std::lock_guard<std::mutex> lock(mu);
-  inflight.erase(ThreadKey(th));
+  auto key = ThreadKey(th);
+  auto it = inflight.find(key);
+  if (it == inflight.end()) return;
+  // Every wait longer than 200 ms, once, with the guest stack captured when it began.
+  auto& f = it->second;
+  auto ms = std::chrono::duration_cast<std::chrono::milliseconds>(
+                std::chrono::steady_clock::now() - f.start)
+                .count();
+  if (ms >= 200) {
+    static const char* kT[] = {"?", "Enum", "Event", "File", "IOCompl", "Module", "Mutant",
+                               "Notify", "Sema", "Session", "Socket", "SymLink", "Thread", "Timer"};
+    std::string what = f.kind == 'D'   ? fmt::format("delay {}ms", f.extra)
+                       : f.kind == 'M' ? fmt::format("waitmulti x{}", f.extra)
+                                       : fmt::format("wait {}", f.extra < 14 ? kT[f.extra] : "?");
+    REXKRNL_INFO("[wait] LONG {} {} ms in {} | stack {:08X} {:08X} {:08X} {:08X} {:08X} {:08X}",
+                 key, ms, what, f.stack[0], f.stack[1], f.stack[2], f.stack[3], f.stack[4],
+                 f.stack[5]);
+  }
+  inflight.erase(it);
+}
+
+// "<thread> | stack ..." for other diagnostics ([file] log in xboxkrnl_io.cpp).
+std::string Describe() {
+  auto* th = XThread::GetCurrentThread();
+  auto st = GuestStack(th);
+  return fmt::format("{} | {:08X} {:08X} {:08X} {:08X} {:08X} {:08X}", ThreadKey(th), st[0], st[1],
+                     st[2], st[3], st[4], st[5]);
 }
 
