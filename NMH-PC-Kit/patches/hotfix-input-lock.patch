 #include <vector>
 
 #include <rex/input/device_assignment.h>
@@ -63,6 +64,9 @@ class InputSystem : public system::IInputSystem {
 
   // Ordered by ordinal. Ordinals are never recycled, so unplugging pad one
   // does not renumber pad two.
+  // Guest threads call GetState/GetCapabilities/SetState/GetKeystroke concurrently (UE3 polls pads
+  // from more than one thread) and each call rebuilds devices_ in RefreshDevices(): serialize them.
+  std::recursive_mutex lock_;
   std::vector<DeviceInfo> devices_;
   std::vector<InputDriver*> device_owners_;
 };
